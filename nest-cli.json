{
	"$schema": "https://json.schemastore.org/nest-cli",
	"collection": "@nestjs/schematics",
	"sourceRoot": "src",
	"type": "swc",
	"externalDependencies": ["node_modules"],
	"compilerOptions": {
		"deleteOutDir": true,
		"builder": "swc",
		"typeCheck": true,
		"plugins": ["@nestjs/swagger"],
		"assets": [{ "include": "i18n/**/*", "watchAssets": true }]
	}
}
